# LLM Provider Keys (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider/model the agent layer should use by default
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# GitHub integration (used by vcs/prGenerator.ts to open PRs)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Local visualizer dashboard
PORT=4000

# Reflection loop tuning
MAX_RETRIES=3
